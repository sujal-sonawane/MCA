#include <reg51.h>

void delay(void)
{
    unsigned int i, j;

    for(i = 0; i < 200; i++)
    {
        for(j = 0; j < 1275; j++);
    }
}

void main(void)
{
    unsigned char code display[15] =
    {
        0x3F, 0x06, 0x5B, 0x4F, 0x66,  // 0-4
        0x6D, 0x7D, 0x07, 0x7F, 0x6F,  // 5-9
        0x77, 0x7C, 0x39, 0x5E, 0x79   // A-E
    };

    unsigned char i;

    while(1)
    {
        for(i = 0; i < 15; i++)
        {
            P2 = display[i];
            delay();
        }
    }
}






