
#include <LPC214x.h>

#define LCD_DATA   0x0000FF00    // P0.8 - P0.15
#define RS         (1 << 4)      // P0.4
#define EN         (1 << 5)      // P0.5
#define RW         (1 << 6)      // P0.6

// Function declarations
void delay(unsigned int count);
void LCD_Command(unsigned char cmd);
void LCD_Data(unsigned char data);
void LCD_Init(void);
void LCD_String(char *str);

int main(void)
{
    // Configure LCD pins as GPIO
    PINSEL0 &= 0x0000C0FF;

    // Configure LCD pins as outputs
    IO0DIR |= 0x0000FF70;

    // Initialize LCD
    LCD_Init();

    // Display student name
    LCD_String("SUJAL");

    while(1);
}

// Delay function
void delay(unsigned int count)
{
    unsigned int i, j;

    for(i = 0; i < count; i++)
    {
        for(j = 0; j < 6000; j++);
    }
}

// Send command to LCD
void LCD_Command(unsigned char cmd)
{
    IO0CLR = LCD_DATA;
    IO0SET = ((unsigned int)cmd << 8);

    IO0CLR = RS;
    IO0CLR = RW;

    IO0SET = EN;
    delay(1);
    IO0CLR = EN;

    delay(2);
}

// Send data to LCD
void LCD_Data(unsigned char data)
{
    IO0CLR = LCD_DATA;
    IO0SET = ((unsigned int)data << 8);

    IO0SET = RS;
    IO0CLR = RW;

    IO0SET = EN;
    delay(1);
    IO0CLR = EN;

    delay(2);
}

// LCD initialization
void LCD_Init(void)
{
    LCD_Command(0x38);    // 8-bit, 2 lines
    LCD_Command(0x0C);    // Display ON, cursor OFF
    LCD_Command(0x06);    // Auto increment cursor
    LCD_Command(0x01);    // Clear display
    LCD_Command(0x80);    // First row, first position
}

// Display string
void LCD_String(char *str)
{
    while(*str)
    {
        LCD_Data(*str);
        str++;
    }
}
