SQUARE WAVE
#include <reg51.h>

void delay(void)
{
    TMOD = 0x01;       // Timer 0, Mode 1

    TH0 = 0xFE;        // Load higher byte
    TL0 = 0x33;        // Load lower byte

    TF0 = 0;           // Clear overflow flag
    TR0 = 1;           // Start Timer 0

    while(TF0 == 0);   // Wait for overflow

    TR0 = 0;           // Stop Timer 0
    TF0 = 0;           // Clear overflow flag
}

void main(void)
{
    while(1)
    {
        P1 = 0xFF;     // Digital HIGH
        delay();

        P1 = 0x00;     // Digital LOW
        delay();
    }
}


TRIANGULAR WAE
#include <reg51.h> 
 
void delay(void) 
{ 
    unsigned int i; 
    for(i = 0; i < 20; i++); 
} 
 
void main(void) 
{ 
    unsigned int i; 
 
    while(1) 
    { 
        for(i = 0; i <= 255; i++) 
        { 
            P1 = (unsigned char)i; 
            delay(); 
        } 
 
        for(i = 255; i > 0; i--) 
 
        { 
            P1 = (unsigned char)i; 
            delay(); 
        } 
    } 
}


