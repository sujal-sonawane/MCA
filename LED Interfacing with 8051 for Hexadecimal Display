/*- Program : Display of Hexadecimal Numbers on Port 2  */ 
#include <reg51.h>          // Include 8051 register definitions 
// Function Prototype 
void delay(void); 
void delay(void) 
{ 
    unsigned int i, j; 
    for(i = 0; i < 500; i++) 
    { 
        for(j = 0; j < 1275; j++); 
    } 
} 
 
void main(void) 
{ 
    unsigned char hex;      // Variable to store hexadecimal count 
    while(1)                // Infinite loop 
    { 
        // Display hexadecimal values from 00H to FFH 
        for(hex = 0x00; hex < 0xFF; hex++) 
        { 
            P2 = hex;       // Send hexadecimal value to Port 2 
            delay();        // Wait for a short duration 
        } 
        // Display the last hexadecimal value (FFH) 
        P2 = 0xFF; 
        delay(); 
    } 
} 
